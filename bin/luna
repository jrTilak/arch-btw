#!/usr/bin/env bash
set -euo pipefail

# Follow the command's symlink so a checkout can live anywhere, including paths
# with spaces. A moved checkout needs its consumer link refreshed.
command_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
checkout_dir="$(dirname -- "$(dirname -- "$command_path")")"

if ! command -v luajit >/dev/null 2>&1; then
    printf 'luna: LuaJIT is required; run the project setup first.\n' >&2
    exit 1
fi

exec luajit "$checkout_dir/src/cli/main.lua" "$@"
